-- LocalScript | StarterPlayerScripts

local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")

local player = Players.LocalPlayer
local mouse = player:GetMouse()

-- ================= GUI =================
local gui = Instance.new("ScreenGui")
gui.Name = "DeleteToolGui"
gui.Parent = player:WaitForChild("PlayerGui")

-- Confirm Frame kiri
local confirmGui = Instance.new("Frame")
confirmGui.Size = UDim2.fromScale(0.25, 0.18)
confirmGui.Position = UDim2.fromScale(0.02, 0.4)
confirmGui.BackgroundColor3 = Color3.fromRGB(25,25,25)
confirmGui.Visible = false
confirmGui.Parent = gui

-- Rounded frame + stroke
local frameCorner = Instance.new("UICorner")
frameCorner.CornerRadius = UDim.new(0,10)
frameCorner.Parent = confirmGui

local frameStroke = Instance.new("UIStroke")
frameStroke.Color = Color3.fromRGB(255,255,255)
frameStroke.Thickness = 2
frameStroke.Parent = confirmGui

local title = Instance.new("TextLabel")
title.Size = UDim2.fromScale(1, 0.35)
title.Text = "Are you sure?"
title.TextScaled = true
title.BackgroundTransparency = 1
title.TextColor3 = Color3.new(1,1,1)
title.Parent = confirmGui

-- ================= FUNCTION CREATE BUTTON =================
local function createButton(parent, size, position, bgColor, text)
	local btn = Instance.new("TextButton")
	btn.Size = size
	btn.Position = position
	btn.BackgroundTransparency = 1
	btn.Text = ""
	btn.Parent = parent

	local bg = Instance.new("Frame")
	bg.Size = UDim2.fromScale(1,1)
	bg.Position = UDim2.new(0,0,0,0)
	bg.BackgroundColor3 = bgColor
	bg.Parent = btn

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 10)
	corner.Parent = bg

	local stroke = Instance.new("UIStroke")
	stroke.Color = Color3.fromRGB(255,255,255)
	stroke.Thickness = 2
	stroke.Parent = bg

	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1,1)
	label.BackgroundTransparency = 1
	label.Text = text
	label.TextScaled = true
	label.TextColor3 = Color3.new(1,1,1)
	label.Parent = btn

	return btn
end

-- CANCEL & SURE buttons
local cancelBtn = createButton(confirmGui, UDim2.fromScale(0.45,0.35), UDim2.fromScale(0.03,0.55), Color3.fromRGB(200,0,0), "CANCEL")
local sureBtn = createButton(confirmGui, UDim2.fromScale(0.45,0.35), UDim2.fromScale(0.52,0.55), Color3.fromRGB(0,200,0), "SURE")

-- ================= VARIABLES =================
local tool
local selectedTarget
local originalColors = {} -- table untuk nyimpen warna asli tiap objek
local holdingTool = false

-- ================= CREATE TOOL =================
local function createTool()
	if tool then return end
	tool = Instance.new("Tool")
	tool.Name = "DELETE"
	tool.RequiresHandle = false

	if player.Character then
		tool.Parent = player.Backpack
	else
		player.CharacterAdded:Wait()
		tool.Parent = player.Backpack
	end
end

createTool()

-- ================= RESET TARGET =================
local function resetTarget()
	if selectedTarget then
		if originalColors[selectedTarget] then
			selectedTarget.Color = originalColors[selectedTarget]
			originalColors[selectedTarget] = nil
		end
	end
	selectedTarget = nil
	confirmGui.Visible = false
end

-- ================= TOOL HOLD DETECTION =================
tool.Equipped:Connect(function()
	holdingTool = true
end)

tool.Unequipped:Connect(function()
	holdingTool = false
	resetTarget()
end)

-- ================= DELETE LOGIC =================
UserInputService.InputBegan:Connect(function(input, gp)
	if gp then return end
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		if holdingTool then
			local target = mouse.Target
			if target and target:IsA("BasePart") then
				-- reset warna objek sebelumnya
				if selectedTarget and selectedTarget ~= target then
					if originalColors[selectedTarget] then
						selectedTarget.Color = originalColors[selectedTarget]
						originalColors[selectedTarget] = nil
					end
				end

				selectedTarget = target
				-- simpan warna asli cuma sekali
				if not originalColors[target] then
					originalColors[target] = target.Color
				end

				target.Color = Color3.fromRGB(255,0,0) -- penanda
				confirmGui.Visible = true
			end
		end
	end
end)

-- ================= BUTTON EVENTS =================
cancelBtn.MouseButton1Click:Connect(resetTarget)

sureBtn.MouseButton1Click:Connect(function()
	if selectedTarget then
		selectedTarget:Destroy()
	end
	resetTarget()
end)
